---
import Base from '../../layouts/Base.astro';
import CallingCard, { type Fact } from '../../components/CallingCard.astro';
import FeedLens from '../../components/FeedLens.astro';
import { placeListings } from '../../lib/records';

export function getStaticPaths() {
  return placeListings().map((p) => ({
    params: { id: p.id.replace('place.', '') },
    props: { place: p },
  }));
}

const { place } = Astro.props;

// In-world facts only — read from the location file's labelled lines, never
// from its frontmatter `description` or `## Story Significance` (both are craft
// notes and several give the ending away). See lib/codex.ts.
const facts: Fact[] = [
  place.kind && { label: 'Type', value: place.kind },
  place.address && { label: 'Where', value: place.address },
  place.hours && { label: 'Hours', value: place.hours },
  place.owner && { label: 'Owner', value: place.owner },
].filter(Boolean) as Fact[];
---

<Base
  title={`${place.name} — Supper Club Secrets`}
  description={`${place.name} — a place in the case, and everything that has happened there up to how far you've read.`}
>
  <article class="hub">
    <CallingCard
      eyebrow="A Place in the Case"
      name={place.name}
      bio={place.blurb}
      facts={facts}
    />

    <FeedLens
      kind="place"
      entityId={place.id}
      bare
      relations
      threadLabel="Everything that happened here"
    />
  </article>
</Base>
