---
import Base from '../../layouts/Base.astro';
import CallingCard from '../../components/CallingCard.astro';
import FeedLens from '../../components/FeedLens.astro';
import { characterHubs, ANTAGONIST, HANDLE_DOMAIN } from '../../lib/records';

export function getStaticPaths() {
  return characterHubs().map((hub) => ({
    params: { id: hub.slug },
    props: { hub },
  }));
}

const { hub } = Astro.props;
const { name, id, profile } = hub;
const club = profile ? profile.club : false;
const eyebrow = club ? 'A Regular' : id === ANTAGONIST ? 'In the Case' : 'At the Table';

// Only the six regulars carry an authored public persona. For everyone else the
// card is a name and a handle at most: the compiler's `oneLine` is a craft note
// that states their function in the plot, so there is nothing safe to print.
const bio = profile?.personaPublic ?? null;
---

<Base title={`${name} — Supper Club Secrets`} description={bio ?? `${name} — Supper Club Secrets`}>
  <article class="hub">
    <CallingCard
      eyebrow={eyebrow}
      name={name}
      handle={profile?.handle ?? null}
      handleDomain={HANDLE_DOMAIN}
      bio={bio}
      tagline={profile?.keyContradiction ?? null}
    />

    <FeedLens
      kind="character"
      entityId={id}
      bare
      relations
      threadLabel="Through the case"
    />
  </article>
</Base>
