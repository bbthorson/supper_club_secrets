---
import Base from '../../layouts/Base.astro';
import { clubListings, HANDLE_DOMAIN } from '../../lib/records';
import { currentBook } from '../../lib/books';
import '../../styles/lens.css';

// Only the supper club is server-rendered. Everyone else the reader meets by
// reading: the compiler emits a profile for every character file with an
// `## Overview`, and those Overviews are craft notes — the supporting cast's
// give away Book 1's ending. So the rest of the cast is assembled client-side
// from horizon-gated fragments, which name only characters the reader has
// actually met on the page.
const club = clubListings();
// The roster is series-level, but 'everyone else you've met' is drawn from a
// book's scenes, so the section is told which book to read.
const book = currentBook();
---

<Base
  title="The Regulars — Supper Club Secrets"
  description="The six who gather around Emma's table, one dinner a week."
>
  <section class="roster-intro">
    <p class="eyebrow scs-label">Around the Table</p>
    <h1 class="roster-title scs-poster">The Regulars</h1>
    <p class="roster-sub scs-romance">Six friends, one standing reservation.</p>
  </section>

  <ul class="roster">
    {
      club.map((c) => (
        <li class="regular">
          <a class="regular-link" href={`/characters/${c.id.replace('char.', '')}`}>
            <div class="regular-head">
              <h2 class="regular-name scs-title">{c.name}</h2>
              {c.handle && (
                <span class="regular-handle">
                  @{c.handle}
                  <span class="regular-handle-dom">.{HANDLE_DOMAIN}</span>
                </span>
              )}
              <span class="scs-leader" aria-hidden="true" />
            </div>
            {c.personaPublic && <p class="regular-persona">{c.personaPublic}</p>}
          </a>
        </li>
      ))
    }
  </ul>

  <section class="met" data-met data-book={book.id} data-club={club.map((c) => c.id).join(',')}>
    <div class="course-head">
      <span class="course-label scs-label">Everyone else you've met</span>
      <span class="scs-leader" aria-hidden="true"></span>
    </div>
    <p class="met-note scs-label" data-met-note>
      <span class="met-bar" aria-hidden="true"></span>
      The rest of the table fills in as you read.
    </p>
    <div class="detail-meta" data-met-list></div>
  </section>
</Base>

<style>
  .roster-intro {
    text-align: center;
    margin-bottom: 2.4rem;
  }
  .eyebrow {
    color: var(--scs-ornament);
    margin: 0 0 0.7rem;
  }
  .roster-title {
    font-size: clamp(2.4rem, 7vw, 4rem);
    margin: 0;
  }
  .roster-sub {
    color: var(--scs-ink-muted);
    font-size: var(--scs-text-romance);
    margin: 0.6rem 0 0;
  }

  .roster {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .regular {
    border-bottom: var(--scs-leader);
  }
  .regular-link {
    display: block;
    padding: 1.3rem 0.3rem;
    text-decoration: none;
    color: var(--scs-ink);
    transition: background-color 0.15s ease;
  }
  .regular-link:hover {
    background: var(--scs-well);
  }
  .regular-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .regular-name {
    font-size: 1.5rem;
    margin: 0;
  }
  .regular-handle {
    font-family: var(--scs-font-label);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--scs-accent);
    white-space: nowrap;
  }
  .regular-handle-dom {
    color: var(--scs-ink-muted);
  }
  /* With the handle alongside, the leader has no room left on a phone and
     strands as a stub at the end of the line — drop it and let the row breathe. */
  @media (max-width: 34rem) {
    .regular-head .scs-leader {
      display: none;
    }
  }
  .regular-persona {
    font-family: var(--scs-font-body);
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--scs-ink);
    margin: 0.5rem 0 0;
  }

  .met {
    margin-top: 2.6rem;
  }
  .met-note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--scs-ink-muted);
    margin: 0;
  }
  .met-bar {
    display: inline-block;
    width: 3.5rem;
    height: 0.85rem;
    border-radius: 2px;
    background: var(--scs-redaction);
    opacity: 0.72;
    flex: none;
  }
</style>

<script>
  import { resolveHorizon } from '../../lib/horizon';
  import { loadUpToHorizon, allEntries } from '../../lib/lens-data';
  import { chip, charHref } from '../../lib/lens-render';

  const root = document.querySelector<HTMLElement>('[data-met]');
  if (root) {
    const clubIds = new Set((root.dataset.club ?? '').split(',').filter(Boolean));
    const noteEl = root.querySelector<HTMLElement>('[data-met-note]');
    const listEl = root.querySelector<HTMLElement>('[data-met-list]');

    (async () => {
      const bookId = root.dataset.book ?? '';
      const horizon = resolveHorizon(bookId);
      const entries = allEntries(await loadUpToHorizon(horizon, bookId));

      // Everyone who has shared a scene with the reader, minus the six already
      // listed above. Sourced from the fetched fragments, so a character the
      // reader hasn't reached is never named here.
      const met = new Map<string, string>();
      for (const e of entries) {
        for (const p of e.participants) if (!clubIds.has(p.id)) met.set(p.id, p.name);
      }

      if (!met.size || !listEl || !noteEl) return;
      const names = [...met.entries()].sort((a, b) => a[1].localeCompare(b[1]));
      listEl.innerHTML = names.map(([id, name]) => chip(name, charHref(id))).join('');
      noteEl.textContent = `Met through Chapter ${horizon}.`;
      noteEl.classList.add('is-filled');
    })();
  }
</script>

<style is:global>
  /* once filled, the note is a plain caption — the redaction bar goes away */
  .met-note.is-filled {
    display: block;
    margin-bottom: 0.7rem;
  }
</style>
