---
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import { currentBook, bookHref } from '../lib/books';

const book = currentBook();

// The cellar — the series list, named the way a restaurant names the document
// that sits beside the menu. Books 2–6 are real (the series is planned
// Oct 2026 → Mar 2027) but their menus aren't public, so they're laid down here
// as redaction-sealed spines rather than absent.
const upcoming = ['Two', 'Three', 'Four', 'Five', 'Six'];
---

<Base
  title="The Cellar — Supper Club Secrets"
  description="The series cellar — what's served, and what's still laid down."
>
  <section class="cellar-intro">
    <p class="eyebrow scs-label">The Series</p>
    <h1 class="cellar-title scs-poster">The Cellar</h1>
    <p class="cellar-sub scs-romance">Six suppers, October through March. One is served.</p>
  </section>

  <article class="book book--one" data-book={book.id} data-total={book.totalChapters} data-read-base={`/books/${book.slug}/read`}>
    <div class="book-face">
      <p class="book-eyebrow scs-label">Book {book.ordinal} · {book.month}</p>
      <h2 class="book-name scs-title">{book.title}</h2>
      <p class="book-line scs-romance">Hosted by {book.host} · {book.totalChapters} chapters</p>
      <div class="book-status">
        <span class="status-text scs-label" data-status>In the kitchen…</span>
        <span class="stamp-slot" data-stamp hidden>
          <Stamp text="Case Closed" />
        </span>
      </div>
      {/* The menu, not chapter one: the cellar is where you choose a book, and
          the menu is how a house hands one over. Only a reader who is already
          mid-book gets pointed straight at a chapter. */}
      <a class="book-cta scs-btn scs-label" href={bookHref(book)} data-cta>
        See the menu
      </a>
    </div>
  </article>

  <div class="upcoming">
    {
      upcoming.map((n) => (
        <article class="book book--sealed">
          <p class="book-eyebrow scs-label">Book {n}</p>
          <span class="sealed-title" aria-label="Title not yet revealed" />
          <p class="book-line scs-label">Still laid down</p>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .cellar-intro {
    text-align: center;
    margin-bottom: 2.6rem;
  }
  .eyebrow {
    color: var(--scs-ornament);
    margin: 0 0 0.7rem;
  }
  .cellar-title {
    font-size: clamp(2.4rem, 7vw, 4rem);
    margin: 0;
  }
  .cellar-sub {
    color: var(--scs-ink-muted);
    font-size: var(--scs-text-romance);
    margin: 0.6rem 0 0;
  }

  .book--one {
    background: var(--scs-surface);
    border: 1px solid var(--scs-line);
    border-radius: var(--scs-radius);
    padding: clamp(1.5rem, 4vw, 2.6rem);
    text-align: center;
  }
  .book-eyebrow {
    color: var(--scs-ornament);
    margin: 0 0 0.6rem;
  }
  .book-name {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0;
  }
  .book-line {
    color: var(--scs-ink-muted);
    margin: 0.5rem 0 0;
  }
  .book-status {
    min-height: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.4rem 0 0.4rem;
  }
  .status-text {
    color: var(--scs-ink-muted);
  }
  /* layout only — see .scs-btn in base.css */
  .book-cta {
    margin-top: 0.6rem;
  }

  .upcoming {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.9rem;
    margin-top: 1.6rem;
  }
  .book--sealed {
    border: 1px dashed var(--scs-line);
    border-radius: var(--scs-radius);
    padding: 1.2rem 1rem;
    text-align: center;
    opacity: 0.85;
  }
  .sealed-title {
    display: block;
    height: 0.95rem;
    width: 70%;
    margin: 0.7rem auto;
    border-radius: 2px;
    background: var(--scs-redaction);
    opacity: 0.55;
  }
  .book--sealed .book-line {
    font-size: var(--scs-text-label);
    letter-spacing: var(--scs-label-tracking);
    text-transform: uppercase;
  }
</style>

<script>
  import { getHorizon } from '../lib/horizon';

  const card = document.querySelector<HTMLElement>('[data-book]');
  const total = Number.parseInt(card?.dataset.total ?? '', 10) || 0;
  const readBase = card?.dataset.readBase ?? '';
  const horizon = getHorizon(card?.dataset.book ?? '');
  const statusEl = document.querySelector<HTMLElement>('[data-status]');
  const stampEl = document.querySelector<HTMLElement>('[data-stamp]');
  const ctaEl = document.querySelector<HTMLAnchorElement>('[data-cta]');

  if (statusEl) {
    if (horizon >= total) {
      statusEl.hidden = true;
      if (stampEl) stampEl.hidden = false;
      if (ctaEl) ctaEl.textContent = 'Read it again';
      /* href stays on the menu: someone re-reading picks their chapter */
    } else if (horizon > 0) {
      statusEl.textContent = `In progress · Chapter ${horizon}`;
      if (ctaEl) {
        const next = Math.min(horizon + 1, total);
        ctaEl.textContent = `Continue · Chapter ${next}`;
        ctaEl.href = `${readBase}/${next}`;
      }
    } else {
      statusEl.textContent = 'Not started';
      /* the server-rendered CTA — "See the menu", pointed at the menu — is
         already right for a reader who hasn't started */
    }
  }
</script>
