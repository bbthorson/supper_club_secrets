---
// A horizon-gated feed: the scenes (and, for a character, state changes) tied to
// one entity, in reading order. The scaffold is entity metadata only (already
// public); scene detail is fetched client-side up to the reader's horizon.
// title / eyebrow drive the poster intro, so they're required in the default
// mode and optional when `bare` suppresses that intro (e.g. under a hub header).
import { currentBook, timelineHref } from '../lib/books';
import '../styles/lens.css';
type Props = {
  kind: 'place' | 'character';
  entityId: string; // full id, e.g. place.mcgolrick-market / char.emma
  subtitle?: string;
  /** Label for the compact header in bare mode. */
  threadLabel?: string;
  /** Render the entity's connections (who they're seen with, where they turn
   *  up) as chip rows above the feed — the "links" of a link-in-bio page.
   *  Derived from the same horizon-bounded fragments, so it gates for free. */
  relations?: boolean;
} & (
  | { bare: true; title?: string; eyebrow?: string }
  | { bare?: false; title: string; eyebrow: string }
);
const {
  kind,
  entityId,
  title,
  subtitle,
  eyebrow,
  bare = false,
  threadLabel = 'Their thread',
  relations = false,
} = Astro.props;

// Threads are book-scoped even though the hubs are series-level, so the lens is
// told which book's fragments to read. Today that is the current book; when a
// second book ships, a hub loads each book at its own horizon and labels the
// sections.
const book = currentBook();
---

<section class="feed" data-feed data-feed-kind={kind} data-feed-id={entityId} data-feed-book={book.id}>
  {
    bare ? (
      <div class="feed-barehead">
        {/* with relations on, the thread heading moves down to sit directly
            above the feed, and the barehead carries only the horizon note */}
        {!relations && (
          <div class="course-head">
            <span class="course-label scs-label">{threadLabel}</span>
            <span class="scs-leader" aria-hidden="true" />
          </div>
        )}
        <p class="feed-note scs-label" data-feed-note />
      </div>
    ) : (
      <div class="feed-intro">
        <p class="eyebrow scs-label">{eyebrow}</p>
        <h1 class="feed-title scs-poster">{title}</h1>
        {subtitle && <p class="feed-sub scs-romance">{subtitle}</p>}
        <p class="feed-note scs-label" data-feed-note />
      </div>
    )
  }

  {
    relations && (
      <div class="feed-relations" data-feed-relations hidden>
        <div class="rel-group" data-rel-group="people" hidden>
          <p class="rel-label scs-label" data-rel-label="people" />
          <div class="detail-meta" data-rel-list="people" />
        </div>
        <div class="rel-group" data-rel-group="places" hidden>
          <p class="rel-label scs-label" data-rel-label="places" />
          <div class="detail-meta" data-rel-list="places" />
        </div>
      </div>
    )
  }

  <div class="feed-thread">
    {
      relations && (
        <div class="course-head">
          <span class="course-label scs-label">{threadLabel}</span>
          <span class="scs-leader" aria-hidden="true" />
        </div>
      )
    }
    <div data-feed-list>
      <p class="feed-empty">Loading what you've read…</p>
    </div>
  </div>

  <div class="feed-states" data-feed-states hidden>
    <div class="course-head">
      <span class="course-label scs-label">How they changed</span>
      <span class="scs-leader" aria-hidden="true"></span>
    </div>
    <div data-feed-states-list></div>
  </div>

  <p class="feed-foot scs-label"><a href={timelineHref(book)}>← The whole timeline</a></p>
</section>

<style>
  .feed-intro {
    text-align: center;
    margin-bottom: 2.2rem;
  }
  .eyebrow {
    color: var(--scs-ornament);
    margin: 0 0 0.6rem;
  }
  .feed-title {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin: 0;
  }
  .feed-sub {
    color: var(--scs-ink-muted);
    font-size: var(--scs-text-romance);
    margin: 0.6rem auto 0;
    max-width: 44ch;
  }
  .feed-note {
    color: var(--scs-accent);
    margin: 0.9rem 0 0;
  }

  /* feed-card / chip / state-row (client-injected) styles live in
     styles/lens.css — scoped styles don't reach innerHTML-injected nodes. */
  /* .feed-empty is re-injected client-side, so its rule lives in
     styles/lens.css with the other innerHTML-rendered nodes. */
  .feed-barehead {
    margin-bottom: 1.6rem;
  }
  .feed-relations {
    margin-bottom: 2rem;
  }
  .rel-group + .rel-group {
    margin-top: 1.1rem;
  }
  .rel-label {
    color: var(--scs-ornament);
    margin: 0 0 0.55rem;
  }
  .feed-thread {
    margin-top: 1.6rem;
  }
  .feed-states {
    margin-top: 2rem;
  }
  .course-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.7rem;
  }
  .course-label {
    color: var(--scs-accent);
    white-space: nowrap;
  }
  .feed-foot {
    margin-top: 2.4rem;
    padding-top: 1.4rem;
    border-top: var(--scs-leader);
  }
  .feed-foot a {
    color: var(--scs-ink-muted);
    text-decoration: none;
  }
  .feed-foot a:hover {
    color: var(--scs-accent);
  }
</style>

<script>
  import { resolveHorizon } from '../lib/horizon';
  import { loadUpToHorizon, allEntries } from '../lib/lens-data';
  import { entryCard, esc, chip, charHref, placeHref } from '../lib/lens-render';
  import type { NamedRef } from '../lib/records';

  const root = document.querySelector<HTMLElement>('[data-feed]');
  if (root) {
    const kind = root.dataset.feedKind as 'place' | 'character';
    const id = root.dataset.feedId ?? '';
    const listEl = root.querySelector<HTMLElement>('[data-feed-list]');
    const noteEl = root.querySelector<HTMLElement>('[data-feed-note]');
    const statesWrap = root.querySelector<HTMLElement>('[data-feed-states]');
    const statesList = root.querySelector<HTMLElement>('[data-feed-states-list]');

    (async () => {
      const bookId = root.dataset.feedBook ?? '';
      const horizon = resolveHorizon(bookId);
      if (noteEl) {
        noteEl.textContent =
          horizon <= 0 ? 'Nothing unlocked yet.' : `Showing through Chapter ${horizon}.`;
      }

      const entries = allEntries(await loadUpToHorizon(horizon, bookId));
      const matched =
        kind === 'place'
          ? entries.filter((e) => e.places.some((p) => p.id === id))
          : entries.filter((e) => e.participants.some((p) => p.id === id));

      if (listEl) {
        // The note above already says nothing is unlocked, so don't say it
        // twice — at horizon 0 this line explains what will appear instead.
        const empty =
          horizon <= 0
            ? 'Every scene they appear in shows up here, a chapter at a time, as you read.'
            : 'Nothing new here yet — read on and this fills in.';
        listEl.innerHTML = matched.length
          ? matched.map((e) => entryCard(e, id)).join('')
          : `<p class="feed-empty">${empty}</p>`;
      }

      // Connections, from the same horizon-bounded entries the feed just used —
      // so they unlock in step with the reader and never name someone from a
      // chapter they haven't reached.
      const relRoot = root.querySelector<HTMLElement>('[data-feed-relations]');
      if (relRoot && matched.length) {
        const dedupe = (refs: NamedRef[]) => {
          const seen = new Map<string, NamedRef>();
          for (const r of refs) if (r.id !== id && !seen.has(r.id)) seen.set(r.id, r);
          return [...seen.values()].sort((a, b) => a.name.localeCompare(b.name));
        };
        const people = dedupe(matched.flatMap((e) => e.participants));
        const places = dedupe(matched.flatMap((e) => e.places));

        const fill = (group: 'people' | 'places', label: string, refs: NamedRef[]) => {
          if (!refs.length) return false;
          const wrap = relRoot.querySelector<HTMLElement>(`[data-rel-group="${group}"]`);
          const labelEl = relRoot.querySelector<HTMLElement>(`[data-rel-label="${group}"]`);
          const list = relRoot.querySelector<HTMLElement>(`[data-rel-list="${group}"]`);
          if (!wrap || !labelEl || !list) return false;
          labelEl.textContent = label;
          list.innerHTML = refs
            .map((r) =>
              group === 'people'
                ? chip(r.name, charHref(r.id))
                : chip(r.name, placeHref(r.id), 'place'),
            )
            .join('');
          wrap.hidden = false;
          return true;
        };

        const shownPeople = fill(
          'people',
          kind === 'place' ? "Who you've seen here" : 'Seen with',
          people,
        );
        const shownPlaces = kind === 'character' && fill('places', 'Where they turn up', places);
        relRoot.hidden = !(shownPeople || shownPlaces);
      }

      if (kind === 'character') {
        const states = entries
          .flatMap((e) => e.states)
          .filter((s) => s.subject.id === id)
          .sort((a, b) => a.chapter - b.chapter);
        if (states.length && statesWrap && statesList) {
          statesWrap.hidden = false;
          statesList.innerHTML = states
            .map((s) => `<p class="state-row"><b>Ch ${s.chapter}</b>${esc(s.state)}</p>`)
            .join('');
        }
      }
    })();
  }
</script>
