---
// A book's front page: the menu card, and nothing in front of it. Lives at
// `/books/<slug>`, and only there. `/` is the host stand — a check-in, not a
// menu — and it links here the way a host hands the menu over, so by the time
// you're on this page you've already been told what the house is; repeating
// the series pitch above the card only pushes the card down the screen. The
// card carries its own state (its one button names the chapter you're on).
import { getCollection } from 'astro:content';
import MenuCard, { type Course } from './MenuCard.astro';
import { timelineHref, type Book } from '../lib/books';

interface Props {
  book: Book;
}
const { book } = Astro.props;

const now = new Date();
const all = (await getCollection('chapters'))
  // drip serialization: a chapter with a future publishDate isn't served yet.
  // Inert until dates are populated, so serialization stays pure config.
  .filter((c) => !c.data.publishDate || c.data.publishDate <= now)
  .sort((a, b) => a.data.chapter - b.data.chapter);

const courses: Course[] = book.meals.map((meal, i) => ({
  ...meal,
  chapters: all
    .filter((c) => c.data.meal === i + 1)
    .map((c) => ({ chapter: c.data.chapter, title: c.data.title, day: c.data.day })),
}));
---

<MenuCard
  eyebrow={`Book ${book.ordinal}`}
  title={book.title}
  subline={`${book.month} · hosted by ${book.host} · ${book.totalChapters} chapters`}
  footnote="Please inform your host of any secrets before dining."
  courses={courses}
  readBase={`/books/${book.slug}/read`}
  bookId={book.id}
  totalChapters={book.totalChapters}
/>

{/* The timeline used to sit in the header, a tab over every page. It belongs
    here instead: it's a way of re-reading the case, so it's offered from the
    book's own page (and from the foot of every lens) rather than standing over
    the prose. It's spoiler-safe on its own — it shows only what you've read. */}
<p class="menu-aside scs-label">
  <a href={timelineHref(book)}>The case, day by day →</a>
</p>

<style>
  .menu-aside {
    text-align: center;
    margin: 1.4rem 0 0;
  }
  .menu-aside a {
    color: var(--scs-ink-muted);
    text-decoration: none;
  }
  .menu-aside a:hover {
    color: var(--scs-accent);
  }
</style>
