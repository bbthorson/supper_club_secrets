---
// The reading room — Book Mode. The same restaurant as the menu, plated for
// long-form reading: Literata at a 65–70ch measure, generous leading, the
// chapter header in front-of-house type. Night is just the theme.
import Base from './Base.astro';
import { chapterEntities } from '../lib/records';
import { bookHref, readHref, timelineHref, type Book } from '../lib/books';
import { documentUri } from '../lib/standard-site';
import '../styles/lens.css';

interface Props {
  book: Book;
  chapter: number;
  title: string;
  meal: number;
  day?: string;
  date?: string;
  prev: number | null;
  next: number | null;
}
const { book, chapter, title, meal, day, date, prev, next } = Astro.props;
const mealNames = ['', 'One', 'Two', 'Three', 'Four'];
const { places, placeText, participants } = chapterEntities(chapter);
const hasEntities = places.length + placeText.length + participants.length > 0;
---

<Base
  title={`Chapter ${chapter} · ${title} — ${book.title}`}
  book={book}
  ogType="article"
  documentUri={documentUri(chapter)}
  footer="bare"
>
  {/* how far through this chapter you are — the one bit of feedback the
      reading room never gave. Purely decorative, so it's aria-hidden. */}
  <div class="read-progress" aria-hidden="true"><span data-progress-bar></span></div>

  <article class="chapter" data-chapter={chapter} data-book={book.id}>
    <header class="chapter-head">
      <p class="chapter-eyebrow scs-label">
        Meal {mealNames[meal] ?? meal} · Chapter {chapter} of {book.totalChapters}
      </p>
      <h1 class="chapter-title scs-title">{title}</h1>
      {
        (day || date) && (
          <p class="chapter-meta scs-label">
            {[day, date].filter(Boolean).join(' · ')}
          </p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      hasEntities && (
        <section class="in-chapter">
          <div class="course-head">
            <span class="course-label scs-label">In this chapter</span>
            <span class="scs-leader" aria-hidden="true" />
          </div>
          <div class="detail-meta">
            {places.map((p) => (
              <a class="chip place" href={`/places/${p.id.replace('place.', '')}`}>
                {p.name}
              </a>
            ))}
            {placeText.map((t) => (
              <span class="chip place">{t}</span>
            ))}
            {participants.map((c) => (
              <a class="chip" href={`/characters/${c.id.replace('char.', '')}`}>
                {c.name}
              </a>
            ))}
          </div>
        </section>
      )
    }

    {/* Reaching a chapter silently moves the horizon and unlocks the lenses.
        The house says so exactly once per book — on the first read that
        advances it — because it explains a mechanism, and a mechanism only
        needs explaining the first time. See tellOnce() in lib/horizon. */}
    <p class="unlocked" data-unlocked hidden>
      {/* {' '} where a line breaks before a link: the compiler trims the
          trailing space and the words run together without it. */}
      Chapter {chapter} read. The <a href={timelineHref(book)}>timeline</a>, the{' '}
      <a href="/characters">cast</a> and the <a href="/places">neighborhood</a> now show
      everything up to here — and they'll keep pace as you read on.
    </p>

    {/* The end of a chapter has one job. Onward is the button and it is the
        only pop on the page; the way back is a quiet line under it, because a
        reader who wants the previous chapter knows they want it and a reader
        who doesn't should not have to read past it. On the last chapter
        onward is the menu — that is still the forward direction. */}
    <nav class="chapter-nav" aria-label="Chapter navigation">
      {
        next !== null ? (
          <a class="nav-onward scs-label" href={readHref(book, next)}>
            Next course · Chapter {next}
          </a>
        ) : (
          <a class="nav-onward scs-label" href={bookHref(book)}>
            The end · Back to the menu
          </a>
        )
      }
      {
        prev !== null ? (
          <a
            class="nav-back scs-label"
            href={readHref(book, prev)}
            aria-label={`Back to chapter ${prev}`}
          >
            ← Chapter {prev}
          </a>
        ) : (
          <a class="nav-back scs-label" href={bookHref(book)}>
            ← The menu
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .chapter {
    max-width: var(--scs-measure-reading);
    margin: 0 auto;
  }
  .chapter-head {
    text-align: center;
    margin-bottom: 2.4rem;
  }
  .chapter-eyebrow {
    color: var(--scs-accent);
    margin: 0 0 0.7rem;
  }
  .chapter-title {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin: 0;
    color: var(--scs-ink);
  }
  .chapter-meta {
    color: var(--scs-ink-muted);
    margin: 0.8rem 0 0;
  }

  .prose {
    font-family: var(--scs-font-body);
    font-size: var(--scs-text-reading);
    line-height: var(--scs-leading-reading);
  }
  /* Literata for the meal itself; Fraunces never sets a paragraph. */
  .prose :global(p) {
    margin: 0 0 1.35em;
    /* the em-dash spacing the prose leans on reads better with slight hanging */
    hanging-punctuation: first;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(hr) {
    border: none;
    text-align: center;
    margin: 2.2em 0;
  }
  .prose :global(hr)::before {
    content: '· · ·';
    color: var(--scs-ornament);
    letter-spacing: 0.5em;
  }

  .read-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 10;
    background: transparent;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--scs-ornament);
    transform-origin: left center;
  }

  .in-chapter {
    margin-top: 3rem;
  }
  .course-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.8rem;
  }
  .course-label {
    color: var(--scs-accent);
    white-space: nowrap;
  }

  /* a sentence, so body type — this is the one place the site explains its own
     gating, and tracked caps make it read as a warning label instead */
  .unlocked {
    margin: 1.8rem 0 0;
    padding: 0.85rem 1.1rem;
    border-left: 3px solid var(--scs-ornament);
    background: var(--scs-linen-deep);
    border-radius: 0 var(--scs-radius) var(--scs-radius) 0;
    font-family: var(--scs-font-body);
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--scs-ink-muted);
  }
  .unlocked[hidden] {
    display: none;
  }
  :global([data-theme='night']) .unlocked {
    background: rgba(241, 232, 212, 0.06);
  }
  .unlocked a {
    color: var(--scs-accent);
    text-decoration: none;
  }
  .unlocked a:hover {
    text-decoration: underline;
  }

  .chapter-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: var(--scs-leader);
  }
  /* The same accent button the menu card serves — the next course is the next
     course wherever it's offered. Full width on a phone, where a centred pill
     is a small target at the end of a long scroll. */
  .nav-onward {
    display: block;
    width: 100%;
    max-width: 22rem;
    padding: 0.9em 1.4em;
    background: var(--scs-accent);
    color: var(--scs-linen);
    border-radius: var(--scs-radius);
    text-align: center;
    text-decoration: none;
    transition: filter 0.18s ease;
  }
  .nav-onward:hover {
    filter: brightness(1.06);
  }
  :global([data-theme='night']) .nav-onward {
    color: var(--scs-bottle);
  }
  .nav-back {
    margin-top: 1.1rem;
    padding: 0.4em 0.2em;
    color: var(--scs-ink-muted);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--scs-accent);
  }
</style>

<script>
  import { getHorizon, setHorizon, applyGates, tellOnce } from '../lib/horizon';

  const el = document.querySelector<HTMLElement>('.chapter[data-chapter]');
  const n = Number.parseInt(el?.dataset.chapter ?? '', 10);
  if (Number.isFinite(n)) {
    // read the old horizon first — the note below only makes sense on the read
    // that actually moved it, not on a re-read of a chapter already behind you
    const bookId = el?.dataset.book ?? '';
    const before = getHorizon(bookId);
    // reaching a chapter advances the reader's horizon
    setHorizon(bookId, n);
    // and re-resolves any redaction now earned
    applyGates(document, bookId);

    // Only on a read that actually advanced the horizon, and only the first
    // time this book ever does it — after that the reader knows.
    if (n > before && tellOnce(`unlocked:${bookId}`)) {
      const note = document.querySelector<HTMLElement>('[data-unlocked]');
      if (note) note.hidden = false;
    }
  }

  // Scroll position through the chapter body, as a hairline at the top.
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  if (bar && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      // a chapter shorter than the viewport has nothing to track
      const pct = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      bar.style.width = `${pct * 100}%`;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
