---
import '../../../protocol/brand/tokens.css';
import '../styles/base.css';
import { inlineHeadScript } from '../lib/horizon-inline';
import ThemeToggle from '../components/ThemeToggle.astro';
import { bookHref, timelineHref, type Book } from '../lib/books';

interface Props {
  title: string;
  description?: string;
  /** Hide the site chrome (header/footer) for full-bleed pages if ever needed. */
  bare?: boolean;
  /** Set on a book-scoped page, which adds that book's own nav (its menu and
   *  timeline) alongside the series-level links. Series pages — the shelf, the
   *  cast, the neighborhood — leave it unset. */
  book?: Book;
  /** Overrides the canonical URL. `/` sets it to the current book's page,
   *  since both render the same menu. */
  canonical?: string;
}
const {
  title,
  description = 'A cozy-crime supper club mystery, served in courses.',
  bare = false,
  book,
  canonical,
} = Astro.props;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- pre-paint: apply stored theme + load progress, no flash -->
    <script is:inline set:html={inlineHeadScript} />
  </head>
  <body>
    {
      !bare && (
        <header class="site-header">
          <a class="wordmark" href="/" aria-label="Supper Club Secrets — home">
            <span class="wm-plain">Supper&nbsp;Club</span>
            <span class="wm-pop">Secrets</span>
          </a>
          <nav class="site-nav scs-label" aria-label="Primary">
            {/* book-scoped first, then the series-level surfaces. The cast and
                the neighborhood are series records, so they never nest. */}
            {book && (
              <>
                <a href={bookHref(book)}>Menu</a>
                <a href={timelineHref(book)}>Timeline</a>
                <span class="nav-div" aria-hidden="true">
                  ·
                </span>
              </>
            )}
            <a href="/shelf">Shelf</a>
            <a href="/characters">Cast</a>
            <a href="/places">Places</a>
          </nav>
          <ThemeToggle />
        </header>
      )
    }
    <main class="site-main">
      <slot />
    </main>
    {
      !bare && (
        <footer class="site-footer scs-label">
          <span class="foot-where">
            Williamsburg, Brooklyn · Thursdays
            <a class="foot-link" href="/kitchen">The Kitchen</a>
          </span>
          <span class="foot-note">Please inform your host of any secrets before dining.</span>
        </footer>
      )
    }
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.4rem;
    flex-wrap: wrap;
    max-width: 62rem;
    margin: 0 auto;
    padding: 1.4rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: var(--scs-leader);
  }
  .site-nav {
    display: flex;
    gap: 1.1rem;
    margin-right: auto;
    margin-left: 0.4rem;
  }
  .site-nav a {
    color: var(--scs-ink-muted);
    text-decoration: none;
  }
  .site-nav a:hover {
    color: var(--scs-accent);
  }
  .nav-div {
    color: var(--scs-line);
  }
  .wordmark {
    font-family: var(--scs-font-display);
    font-weight: 700;
    font-variation-settings: 'opsz' 40;
    font-size: 1.45rem;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .wm-plain {
    color: var(--scs-ink);
  }
  .wm-pop {
    color: var(--scs-accent);
    font-style: italic;
    margin-left: 0.12em;
  }
  .site-main {
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 3.5rem) clamp(1rem, 4vw, 2.5rem);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    max-width: 62rem;
    margin: 2rem auto 0;
    padding: 1.4rem clamp(1rem, 4vw, 2.5rem) 2.6rem;
    border-top: var(--scs-leader);
    color: var(--scs-ink-muted);
  }
  .foot-where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.1rem;
  }
  .foot-link {
    color: var(--scs-ink-muted);
    text-decoration: none;
    border-bottom: 1px dotted var(--scs-ornament);
    padding-bottom: 0.1em;
  }
  .foot-link:hover {
    color: var(--scs-accent);
    border-bottom-color: var(--scs-accent);
  }
  .site-footer .foot-note {
    font-family: var(--scs-font-display);
    font-style: italic;
    font-weight: var(--scs-type-romance-weight);
    font-variation-settings: var(--scs-type-romance-variation);
    letter-spacing: 0;
    text-transform: none;
    font-size: 1rem;
    color: var(--scs-ink-muted);
  }
</style>
