---
import '../../../protocol/brand/tokens.css';
import '../styles/base.css';
import { inlineHeadScript } from '../lib/horizon-inline';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SERIES_TAGLINE, bookHref, currentBook, type Book } from '../lib/books';

interface Props {
  title: string;
  description?: string;
  /** Hide the site chrome (header/footer) for full-bleed pages if ever needed. */
  bare?: boolean;
  /** Set on a book-scoped page. It turns the one header link into the way back
   *  to that book's menu — the only elsewhere a reader mid-book wants. Series
   *  pages — the cellar, the cast, the neighborhood — leave it unset and get
   *  the cellar. */
  book?: Book;
  /** Overrides the canonical URL. */
  canonical?: string;
  /** Set false on the front door: the host stand *is* the navigation, and a
   *  link beside the wordmark undoes the quiet it's built on. The footer still
   *  carries the way to everything. */
  nav?: boolean;
  /** Open Graph type. `article` on a chapter; everything else is a `website`. */
  ogType?: 'website' | 'article';
  /** This page's `site.standard.document` AT-URI, when it has a record. Ties
   *  the page to its record — the other half of standard.site verification. */
  documentUri?: string | null;
  /** How much footer a page gets. `full` is the house default. `lean` drops the
   *  cast and the neighborhood, for a page that is already a destination rather
   *  than a place you pass through — the book's own page, the front door; the
   *  cellar and the kitchen stay, as the way back. `bare` drops the house nav
   *  altogether and leaves only the service toggle: in the reading room the one
   *  thing a reader wants is the next chapter, and four more doors under it is
   *  the house interrupting the book. The header's "Menu" is the way out. */
  footer?: 'full' | 'lean' | 'bare';
  /** Class on <body>, for a page that needs to reshape the chrome around it.
   *  Astro scopes this layout's own selectors, which out-specify a bare global
   *  rule from a page — so a page overriding `.site-main` needs a hook with
   *  more weight than the class alone, not a louder guess. */
  bodyClass?: string;
}
const {
  title,
  description = SERIES_TAGLINE,
  bare = false,
  book,
  canonical,
  nav = true,
  ogType = 'website',
  documentUri = null,
  footer = 'full',
  bodyClass,
} = Astro.props;
const site = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site);
// One card for the whole site, set in the real faces from the locked tokens —
// see scripts/og-card.html. Absolute, because a share crawler has no base URL.
const ogImage = new URL('/og.png', site);

// The header carries exactly one link, and what it should be depends on where
// you are. Mid-book — a chapter, the timeline — the one elsewhere a reader
// wants is the menu they came in through, so that's what it offers. On the
// menu itself (and on every series page) the menu is where you already are,
// and the link becomes the cellar: the way out of this book and into the rest.
const bookMenuHref = book ? bookHref(book) : null;
const onBookMenu = bookMenuHref !== null && Astro.url.pathname.replace(/\/+$/, '') === bookMenuHref;
const wayOut =
  bookMenuHref && !onBookMenu
    ? { href: bookMenuHref, label: 'Menu' }
    : { href: '/cellar', label: 'Cellar' };
// On the cellar itself the link points at the page you're standing on — there
// is no further out. Say so rather than offering it as somewhere to go.
const wayOutIsHere = Astro.url.pathname.replace(/\/+$/, '') === wayOut.href;
---

<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Open Graph only. Twitter/X falls back to these, and Slack, iMessage,
        Discord, Bluesky and the rest read og: directly — a parallel set of
        twitter:* tags would be the same four strings maintained twice. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Supper Club Secrets" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Supper Club Secrets — a weekly supper club in Williamsburg, Brooklyn" />
    {/* standard.site: this page's record, when it has one. Rendered only for a
        chapter whose rkey is in the config — never as a placeholder. */}
    {documentUri && <link rel="site.standard.document" href={documentUri} />}
    <!-- pre-paint: stored theme + which front door this reader gets, no flash -->
    <script is:inline set:html={inlineHeadScript(currentBook().id)} />
  </head>
  <body class={bodyClass}>
    {
      !bare && (
        <header class="site-header">
          <a class="wordmark" href="/" aria-label="Supper Club Secrets — home">
            <span class="wm-plain">Supper&nbsp;Club</span>
            <span class="wm-pop">Secrets</span>
          </a>
          {/* One link, on the right where the service toggle used to sit. The
              cast, the neighborhood and the timeline are surfaces you discover
              by reading — chips at the end of every chapter, on the timeline,
              on every hub — and they sit in the footer and on the menu, not in
              a row of tabs over the prose. */}
          {nav && (
            <a class="nav-out scs-label" href={wayOut.href} aria-current={wayOutIsHere ? 'page' : undefined}>
              {wayOut.label}
            </a>
          )}
        </header>
      )
    }
    <main class="site-main">
      <slot />
    </main>
    {
      !bare && (
        <footer class="site-footer">
          {footer !== 'bare' && (
            <nav class="foot-nav scs-label" aria-label="Secondary">
              <a href="/cellar">The Cellar</a>
              {footer === 'full' && <a href="/characters">The Regulars</a>}
              {footer === 'full' && <a href="/places">The Neighborhood</a>}
              <a href="/kitchen">The Kitchen</a>
            </nav>
          )}
          {/* After hours is a nice thing to find, not a thing to be offered on
              the way in — so it sits at the foot of the page with the rest of
              what the house can do. */}
          <div class="toggle-slot">
            <ThemeToggle />
          </div>
        </footer>
      )
    }
  </body>
</html>

<style>
  /* The sign and the one door out, on a single row at every width. */
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem 1.6rem;
    max-width: 62rem;
    margin: 0 auto;
    padding: 1.4rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: var(--scs-leader);
  }
  .nav-out {
    color: var(--scs-ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-out:hover {
    color: var(--scs-accent);
  }
  .nav-out[aria-current='page'] {
    color: var(--scs-ornament);
  }
  .wordmark {
    font-family: var(--scs-font-display);
    font-weight: 700;
    font-variation-settings: 'opsz' 40;
    font-size: 1.45rem;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .wm-plain {
    color: var(--scs-ink);
  }
  .wm-pop {
    color: var(--scs-accent);
    font-style: italic;
    margin-left: 0.12em;
  }
  .site-main {
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 3.5rem) clamp(1rem, 4vw, 2.5rem);
  }
  /* Stacked and centred, like the foot of a menu card: the way back to
     everything, then the service toggle under it. The old two-column split
     wrapped into an L on a phone. */
  .site-footer {
    max-width: 62rem;
    margin: 2rem auto 0;
    padding: 1.6rem clamp(1rem, 4vw, 2.5rem) 2.8rem;
    border-top: var(--scs-leader);
    color: var(--scs-ink-muted);
    text-align: center;
  }
  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.5rem 1.6rem;
    margin: 0 0 1.3rem;
  }
  .foot-nav a {
    color: var(--scs-ink-muted);
    text-decoration: none;
  }
  .foot-nav a:hover {
    color: var(--scs-accent);
  }
  /* A wrapper, not `.theme-toggle` directly: Astro scopes styles to a
     component's own template, so a selector here never reaches the button
     inside ThemeToggle. */
  .toggle-slot {
    display: flex;
    justify-content: center;
  }
</style>
