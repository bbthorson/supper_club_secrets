{
  "lexicon": 1,
  "id": "com.supperclubsecrets.custodyEvent",
  "description": "A change of custody: an item passing into someone's hands at a point in story time.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "A custody event record.",
      "record": {
        "type": "object",
        "required": [
          "id",
          "item",
          "storyDate",
          "holder",
          "chapterRef",
          "sceneRef",
          "createdAt",
          "sourceFile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable event id, e.g. `custodyEvent.heritage-bottle.book1.ch1`.",
            "maxLength": 256
          },
          "item": {
            "type": "string",
            "description": "Registry id of the item changing hands.",
            "maxLength": 256
          },
          "storyDate": {
            "type": "string",
            "description": "In-story date, `YYYY-MM-DD`.",
            "maxLength": 10
          },
          "storyDateEnd": {
            "type": "string",
            "description": "End of the in-story span.",
            "maxLength": 10
          },
          "holder": {
            "type": "string",
            "description": "Registry id of the character who holds the item after this event.",
            "maxLength": 256
          },
          "fromHolder": {
            "type": "string",
            "description": "Registry id of the previous holder. Absent when the item enters the story here, or when the prior holder is deliberately unnamed — never null.",
            "maxLength": 256
          },
          "event": {
            "type": "string",
            "description": "One-line description of the hand-off, in the author's words.",
            "maxLength": 3000
          },
          "chapterRef": {
            "type": "string",
            "description": "Source chapter, e.g. `book1#ch1`.",
            "maxLength": 256
          },
          "sceneRef": {
            "type": "string",
            "description": "Scene record this event belongs to.",
            "maxLength": 256
          },
          "createdAt": {
            "type": "string",
            "description": "Story time as an RFC3339 datetime.",
            "format": "datetime"
          },
          "sourceFile": {
            "type": "string",
            "description": "Repository-relative chapter path.",
            "maxLength": 1024
          }
        }
      }
    }
  }
}
